  <worksheets>
    <worksheet name='avg delivery vs review score'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>Average Delivery Days Vs. Review Score </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='order_details_updated' name='federated.1hv53430efuoum1072wxk0lqv5xs' />
          </datasources>
          <datasource-dependencies datasource='federated.1hv53430efuoum1072wxk0lqv5xs'>
            <column-instance column='[delivery_days]' derivation='Avg' name='[avg:delivery_days:qk]' pivot='key' type='quantitative' />
            <column-instance column='[review_score]' derivation='CountD' name='[ctd:review_score:qk]' pivot='key' type='quantitative' />
            <column caption='Delivery Days' datatype='real' name='[delivery_days]' role='measure' type='quantitative' />
